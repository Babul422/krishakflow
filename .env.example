# ──────────────────────────────────────────────────────────────────────────────
# KisanFlow — Environment Variable Template
#
# Copy this file to .env.local and fill in your values.
# NEVER commit .env or .env.local to version control.
# NEVER put real credentials in this file.
# ──────────────────────────────────────────────────────────────────────────────


# ──────────────────────────────────────────────────────────────────────────────
# Supabase — Mobile / Browser Client (Public)
#
# These are the public project credentials safe for use in the mobile app and
# browser clients. Access is enforced by Row Level Security (RLS) policies.
# ──────────────────────────────────────────────────────────────────────────────

EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here


# ──────────────────────────────────────────────────────────────────────────────
# Supabase — Admin Dashboard (Next.js) — Public client variables
#
# Use the same project URL. The anon key is safe for the browser-side client.
# ──────────────────────────────────────────────────────────────────────────────

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here


# ──────────────────────────────────────────────────────────────────────────────
# Supabase — Server-Side Only (Edge Functions / Trusted Backend)
#
# WARNING: The service role key bypasses ALL Row Level Security policies.
# It must NEVER be used in mobile apps, browser clients, or Expo code.
# It is included here as a placeholder so developers know the variable exists.
# Provide this value only in trusted server-side environments.
# ──────────────────────────────────────────────────────────────────────────────

# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here  ← SERVER SIDE ONLY


# ──────────────────────────────────────────────────────────────────────────────
# SMS Provider (Server-Side Only — Future Integration)
#
# Required when real SMS gateway integration is implemented (FR-23).
# Must not be present in mobile or browser client configuration.
# ──────────────────────────────────────────────────────────────────────────────

# SMS_API_KEY=your-sms-provider-api-key-here            ← SERVER SIDE ONLY
# SMS_SENDER_ID=KisanFlow


# ──────────────────────────────────────────────────────────────────────────────
# Application
# ──────────────────────────────────────────────────────────────────────────────

APP_ENV=development
# Options: development | staging | production
