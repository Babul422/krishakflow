{
  "expo": {
    "name": "KisanFlow",
    "slug": "kisanflow",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "scheme": "kisanflow",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#1b4332"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.kisanflow.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1b4332"
      },
      "package": "com.kisanflow.app"
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router"
    ]
  }
}
